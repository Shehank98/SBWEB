# ---- Server ----
PORT=4000
# Comma-separated list of origins allowed to call the API (the frontend host).
# Use * only for local development.
CORS_ORIGIN=http://localhost:8000

# ---- Database (Railway injects DATABASE_URL automatically) ----
# Locally you can point at your own Postgres instead:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kade
# Set to "true" when the database requires SSL (most managed providers do).
DATABASE_SSL=false

# ---- Auth ----
# Long random string. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Seed admin (created by npm run db:seed) ----
ADMIN_EMAIL=admin@kade.lk
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Platform Admin

# ---- File uploads ----
# "local"   -> files saved under ./uploads and served at /uploads (default, zero-config)
# "firebase"-> files uploaded to Firebase Storage (set the vars below)
UPLOAD_DRIVER=local
PUBLIC_BASE_URL=http://localhost:4000

# ---- Firebase Storage (only when UPLOAD_DRIVER=firebase) ----
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# Paste the service-account JSON as a single-line string, or set GOOGLE_APPLICATION_CREDENTIALS to a file path.
FIREBASE_SERVICE_ACCOUNT=
